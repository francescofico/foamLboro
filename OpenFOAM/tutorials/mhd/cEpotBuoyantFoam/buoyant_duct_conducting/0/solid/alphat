FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wall thermal diffusivity; it only sets the time scale of the steady solution.
#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform $kappaWall;

boundaryField
{
    "(solid_to_fluid_.*|outer.*|ends.*)"
    {
        type            calculated;
        value           uniform $kappaWall;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

