FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      K;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wall thermal conductivity k_w (system/caseParameters).
#include "$FOAM_CASE/system/caseParameters"

dimensions      [1 1 -3 -1 0 0 0];

internalField   uniform $kWall;

boundaryField
{
    "(solid_to_fluid_.*|outer.*|ends.*)"
    {
        type            fixedValue;
        value           uniform $kWall;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

