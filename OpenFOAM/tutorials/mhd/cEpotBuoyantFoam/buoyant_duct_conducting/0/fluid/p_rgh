FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(fluid_to_solid_.*|side.*)"
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

