FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      sigma;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [-1 -3 3 0 0 2 0];

internalField   uniform 1;

boundaryField
{
    "(fluid_to_solid_.*|side.*)"
    {
        type            fixedValue;
        value           uniform 1;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

