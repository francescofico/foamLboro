FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      B0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Applied field along y. With a = rho = nu = sigma = 1, Ha = B.
#include "$FOAM_CASE/system/caseParameters"

dimensions      [1 0 -2 0 0 -1 0];

internalField   uniform (0 $B 0);

boundaryField
{
    "(fluid_to_solid_.*|side.*)"
    {
        type            zeroGradient;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

