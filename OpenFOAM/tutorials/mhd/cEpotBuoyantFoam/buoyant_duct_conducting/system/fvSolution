FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// coupled true: fluid and solid potentials, and fluid and solid temperatures,
// are each solved as one assembled matrix (matching interface faces, which
// setup.py produces). See cEpotFoam/hunt_duct for why the segregated
// coupling is not used.
coupled         true;

PIMPLE
{
    nOuterCorrectors    1;
}

