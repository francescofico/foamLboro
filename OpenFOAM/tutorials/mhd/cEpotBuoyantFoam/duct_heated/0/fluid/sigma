FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      sigma;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ -1 -3 3 0 0 2 0 ];

sigma 8.9289512E05;

internalField   uniform $sigma;

boundaryField
{
   
   bottom
    {
        type            fixedValue;
        value           uniform $sigma;
    }

    top
    {
        type            fixedValue;
        value           uniform $sigma;
    }

    front
    {
        type            fixedValue;
        value           uniform $sigma;
    }

    back
    {
        type            fixedValue;
        value           uniform $sigma;
    }

    outlet
    {
        type            fixedValue;
        value           uniform $sigma;
    }

    inlet
    {
        type            fixedValue;
        value           uniform $sigma;
    }
}


