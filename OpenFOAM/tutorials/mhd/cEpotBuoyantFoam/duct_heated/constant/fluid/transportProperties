FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// lead lithium calculated at T = 270 C

transportModel  Newtonian;

// dynamic viscosity mu = rho*nu = 2.462E-03 kg/(m s)

nu              nu [0 2 -1 0 0 0 0] 2.4935E-07;

rho             rho [1 -3 0 0 0 0 0] 9873; // density of the fluid

beta            beta [0 0 0 -1 0 0 0] 0.00018; //at 270 C

 // ref temperature for buoyancy computation
 TRef            TRef [0 0 0 1 0 0 0] 273.15; // this is used when buoyancy is on

 // specific heat
 cp              cp [0 2 -2 -1 0 0 0] 139;

Pr             Pr [0 0 0 0 0 0 0] 0.025; // at 270 C
 
Prt              Prt [0 0 0 0 0 0 0] 100; // 
