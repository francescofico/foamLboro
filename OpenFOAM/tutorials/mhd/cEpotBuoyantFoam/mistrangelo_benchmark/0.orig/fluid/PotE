FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      PotE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Electric potential; d(phi)/dx = 0 at inlet and outlet (table 4).
dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|outlet)"
    {
        type            zeroGradient;
    }
    fluid_to_solid
    {
        type            solidWallMixedPotentialCoupled;
        value           uniform 0;
        PotEnbr         PotE;
        sigma           sigma;
    }
}

