FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Uniform inlet velocity u0 (as CFX, OF_ORNL and COMSOL in table 4).
#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ($u0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ($u0 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform ($u0 0 0);
    }
    fluid_to_solid
    {
        type            noSlip;
    }
}

