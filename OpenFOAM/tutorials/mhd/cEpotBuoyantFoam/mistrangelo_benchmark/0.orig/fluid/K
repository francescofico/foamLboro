FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      K;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// PbLi thermal conductivity, used for the interface heat balance.
#include "$FOAM_CASE/system/caseParameters"

dimensions      [1 1 -3 -1 0 0 0];

internalField   uniform $kFluid;

boundaryField
{
    ".*"
    {
        type            fixedValue;
        value           uniform $kFluid;
    }
}

