FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      sigma;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// PbLi electrical conductivity (system/caseParameters).
#include "$FOAM_CASE/system/caseParameters"

dimensions      [-1 -3 3 0 0 2 0];

internalField   uniform $sigmaFluid;

boundaryField
{
    ".*"
    {
        type            fixedValue;
        value           uniform $sigmaFluid;
    }
}

