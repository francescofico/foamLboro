FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      PotE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Electric potential. All walls insulating (as in shercliff_duct).
dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    "(hartmann.*|side.*)"
    {
        type            zeroGradient;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

