FoamFile
{
    version     2.0;
    format      ascii;
    class       uniformDimensionedVectorField;
    location    "constant";
    object      g;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Gravity along -y (y is vertical). |g| = Gr, because a = nu = beta = Delta T = 1.
#include "$FOAM_CASE/system/caseParameters"

dimensions      [0 1 -2 0 0 0 0];

value           (0 $gravityY 0);

