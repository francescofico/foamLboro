FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Non-dimensional: a = nu = rho = sigma = 1, Delta T = beta = 1, kappa = 1/Pr.
#include "$FOAM_CASE/system/caseParameters"

transportModel  Newtonian;

nu              nu   [0 2 -1 0 0 0 0] 1;
rho             rho  [1 -3 0 0 0 0 0] 1;
beta            beta [0 0 0 -1 0 0 0] 1;
TRef            TRef [0 0 0 1 0 0 0] 0;
Pr              Pr   [0 0 0 0 0 0 0] $Pr;
Prt             Prt  [0 0 0 0 0 0 0] 0.85;

// ************************************************************************* //
