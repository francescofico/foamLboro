FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      PotE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Electric potential. All walls insulating. z is periodic with a plain
// cyclic: the net flow across the slot is zero, so the net spanwise current
// sigma B int(u) dy is zero too, and no potential jump is needed (unlike the
// pressure-driven hartmann_channel).
dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    "(hotWall|coldWall|endWalls)"
    {
        type            zeroGradient;
    }
    "zPeriodic.*"
    {
        type            cyclic;
    }
}

