FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      sigma;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [-1 -3 3 0 0 2 0];

internalField   uniform 1;

boundaryField
{
    "(hotWall|coldWall|endWalls)"
    {
        type            fixedValue;
        value           uniform 1;
    }
    "zPeriodic.*"
    {
        type            cyclic;
    }
}

