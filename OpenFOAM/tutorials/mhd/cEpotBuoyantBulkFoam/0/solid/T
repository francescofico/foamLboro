FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 273.15; // in this case solid and fluid are disconnected as gradient is applied to fluid/solid interface

boundaryField
{
    right
    {
        type zeroGradient;
    }
    left
    {
        type zeroGradient;
    }
    bottom
    {
        type fixedValue;
        value uniform 293.15;
    }
    top
    {
        type zeroGradient;
    }
    front
    {
        type zeroGradient;
    }
    back
    {
      type zeroGradient;
    }
    walls
    {
      type zeroGradient;
    }
  

}


