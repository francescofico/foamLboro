FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    arch        "LSB;label=32;scalar=64";
    location    "0/fluid";
    object      K;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 1 -3 -1 0 0 0 ];

internalField   uniform 11.9; // thermal conductivity - this should be consistent with the alphat selected

boundaryField

{
    bottom
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    front
    {
        type            zeroGradient;
    }

    back
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;
    }

    inlet
    {
        type            zeroGradient;
    }

}


