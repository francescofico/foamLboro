FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    arch        "LSB;label=32;scalar=64";
    location    "0/fluid";
    object      Tb;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];


internalField   uniform 273.15;

boundaryField
{
   bottom
    {
        type            zeroGradient;

    }
    

    top
    {
          type            zeroGradient;
    }
    

    front
    {
      type            zeroGradient;
    }
    

    back
    {
        type            zeroGradient;
    }
    

    outlet
    {
        type            zeroGradient;
    }

    inlet
    {
        type            fixedValue;
        value           uniform 273.15;
    }

}


