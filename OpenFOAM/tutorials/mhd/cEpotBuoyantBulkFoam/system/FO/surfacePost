surfacesVTK
{
    type            surfaces;
    libs            (sampling);
    writeControl    writeTime;
    timeStart	    $timeStart;
    region	    fluid;
    surfaceFormat   vtk;
    fields          (U UMean UPrime2Mean JMean lorentzMean);

    // interpolationScheme cellPoint;  //<- default

    surfaces
    {
        zNormal
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   (1 0.025 0.025);
                normal  (0 0 1);
            }
            interpolate     true;
        }
	
	yNormal
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   (1 0.025 0.025);
                normal  (0 1 0);
            }
            interpolate     true;
        }


        xNormal0_5
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   (0.5 0 0);
                normal  (1 0 0);
            }
            interpolate     true;
        }
	
        }


    }
}


