FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//

transportModel  Newtonian;


// dynamic viscosity mu = rho*nu = 0.0021094 kg/(m s)

nu              nu [0 2 -1 0 0 0 0] 1.9906E-07;

rho             rho [1 -3 0 0 0 0 0] 10645; // density of the fluid

