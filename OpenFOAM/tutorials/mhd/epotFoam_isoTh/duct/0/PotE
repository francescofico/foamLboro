FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    arch        "LSB;label=32;scalar=64";
    location    "0";
    object      PotE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 2 -3 0 0 -1 0];


internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
   outlet
    {
        type            zeroGradient;
    }
    fluid_surface
    {
      type            zeroGradient;
    }

}


