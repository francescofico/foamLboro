FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      B0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 0 -2 0 0 -1 0 ];

internalField   uniform ( 0 0.01 0); //  Ha=B0*Dh*sqrt(sigma/mu)=B0*1021.24

boundaryField
{
   
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    fluid_surface
    {
        type            zeroGradient;
    }


}


