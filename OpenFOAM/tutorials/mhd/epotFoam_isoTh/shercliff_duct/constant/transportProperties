FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Non-dimensional properties: with a = ubar = 1, Re = ubar a / nu = 1.
// Fully developed parallel flow has no inertia, so the solution does not
// depend on Re. nu = 1 only sets the time scale.
transportModel  Newtonian;

nu              nu  [0 2 -1 0 0 0 0] 1;

rho             rho [1 -3 0 0 0 0 0] 1;

