FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      PotE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Electric potential. The pipe wall is electrically insulating: dPotE/dn = 0
// (Gold 1962). The level is fixed by PotERefCell in system/fvSolution.
dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    wall
    {
        type            zeroGradient;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

