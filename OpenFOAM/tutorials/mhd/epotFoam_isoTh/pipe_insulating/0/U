FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Non-dimensional units: radius a = 1, bulk velocity ubar = 1.
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1 0 0);

boundaryField
{
    wall
    {
        type            noSlip;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

