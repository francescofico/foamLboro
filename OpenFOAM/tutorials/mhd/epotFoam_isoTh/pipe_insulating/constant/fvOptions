FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Holds the bulk velocity at ubar = 1 by adjusting a uniform pressure
// gradient. The gradient it reports ("pressure gradient = ...") is the
// quantity compared with the analytical value in validate.py.
momentumSource
{
    type            meanVelocityForce;
    selectionMode   all;
    fields          (U);
    Ubar            (1 0 0);
}

