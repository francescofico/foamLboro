FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      B0;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Applied magnetic field along y (normal to the Hartmann walls).
// With a = rho = nu = sigma = 1, Ha = B a sqrt(sigma/(rho nu)) = B.
// Value from system/caseParameters (setup.py).
#include "$FOAM_CASE/system/caseParameters"

dimensions      [1 0 -2 0 0 -1 0];

internalField   uniform (0 $B 0);

boundaryField
{
    hartmannWalls
    {
        type            zeroGradient;
    }
    "(x|z)Periodic.*"
    {
        type            cyclic;
    }
}

