FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      PotE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Electric potential.
//
// Hartmann walls: insulating, dPotE/dn = 0.
//
// Spanwise (z) periodicity: a plain cyclic forces <dPotE/dz> = 0, which is
// the short-circuited Hartmann channel (j_z = sigma u B). For the insulating
// channel the net spanwise current must vanish, which needs
//     dPotE/dz = ubar B   =>   jump across the z pair = ubar B Lz.
// The jump comes from system/caseParameters. Use
// "python3 setup.py --electrodes shorted" for the short-circuited variant (jump 0).
#include "$FOAM_CASE/system/caseParameters"

dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    hartmannWalls
    {
        type            zeroGradient;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
    zPeriodic0
    {
        type            fixedJump;
        patchType       cyclic;
        jump            uniform $potentialJump;
        value           uniform 0;
    }
    zPeriodic1
    {
        type            fixedJump;
        patchType       cyclic;
        value           uniform 0;
    }
}

