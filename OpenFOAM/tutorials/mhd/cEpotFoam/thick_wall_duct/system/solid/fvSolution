FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/solid";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(PotE|PotEFinal)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0.01;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
}

PotE
{
    PotERefCell         0;
    PotERefValue        0;
}

