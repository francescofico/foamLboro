FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      PotE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 2 -3 0 0 -1 0 ];

internalField   uniform 0;

boundaryField
{
    right
    {
        type zeroGradient;
    }
    left
    {
        type zeroGradient;
    }
    bottom
    {
        type zeroGradient;
    }
    top
    {
        type zeroGradient;
    }
    front
    {
        type            solidWallMixedPotentialCoupled; // coupling boundary
        value           uniform 0;
        PotEnbr         PotE;
        sigma           sigma;
    }
    back
    {
        type            solidWallMixedPotentialCoupled; // coupling boundary
        value           uniform 0;
        PotEnbr         PotE;
        sigma           sigma;
    }
    walls
    {
        type zeroGradient;
    }
  

}


