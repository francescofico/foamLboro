transportModel  Newtonian;

// dynamic viscosity mu = rho*nu = 2.462E-03 kg/(m s)

nu              nu [0 2 -1 0 0 0 0] 2.4935E-07;

rho             rho [1 -3 0 0 0 0 0] 9873; // density of the fluid

