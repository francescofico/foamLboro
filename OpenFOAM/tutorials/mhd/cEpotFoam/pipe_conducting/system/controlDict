FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     cEpotFoam;

libs            ("libmhdBoundaryConditions.so");

startFrom       startTime;
startTime       0;
stopAt          endTime;

// deltaT and endTime come from system/caseParameters (setup.py). The Lorentz
// force is explicit, so deltaT must stay below rho/(sigma B^2) = 1/Ha^2.
// endTime covers several side-layer diffusion times (a^2/(nu Ha)).
#include "caseParameters"

endTime         $endTime;
deltaT          $deltaT;

writeControl    runTime;
writeInterval   $endTime;
purgeWrite      0;

writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   8;

runTimeModifiable true;
adjustTimeStep  no;

// ************************************************************************* //
