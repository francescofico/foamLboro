FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      sigma;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wall conductivity sigma_w (fluid sigma = 1). Value from system/caseParameters:
// c = sigma_w t_w / (sigma a).
#include "$FOAM_CASE/system/caseParameters"

dimensions      [-1 -3 3 0 0 2 0];

internalField   uniform $sigmaWall;

boundaryField
{
    "(solid_to_fluid|outerWall)"
    {
        type            fixedValue;
        value           uniform $sigmaWall;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

