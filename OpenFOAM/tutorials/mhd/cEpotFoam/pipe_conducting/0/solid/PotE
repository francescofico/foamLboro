FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      PotE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Electric potential in the conducting pipe wall.
//   solid_to_fluid: coupled to the fluid
//   outerWall:      insulating, dPotE/dn = 0
dimensions      [1 2 -3 0 0 -1 0];

internalField   uniform 0;

boundaryField
{
    solid_to_fluid
    {
        type            solidWallMixedPotentialCoupled;
        value           uniform 0;
        PotEnbr         PotE;
        sigma           sigma;
    }
    outerWall
    {
        type            zeroGradient;
    }
    "xPeriodic.*"
    {
        type            cyclic;
    }
}

